.menu-topbar {
    position: absolute;
    left: 64px;
    right: 64px;
    top: 42px;
    height: 78px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--vp-border);
    padding-bottom: 14px;
}

.identity {
    flex-direction: row;
    align-items: center;
}

.identity__badge {
    width: 58px;
    height: 58px;
    border-width: 1px;
    border-color: var(--vp-border-strong);
    color: var(--vp-amber);
    font-size: 21px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 20px;
}

.identity__name {
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}

.connection {
    color: var(--vp-dim);
    font-size: 13px;
    -unity-font-style: bold;
}

.menu-screen {
    padding-top: 142px;
}

.menu-scan-sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(232, 166, 61, 0.16);
    opacity: 0.5;
}

.landing {
    position: absolute;
    left: 6.7%;
    top: 35%;
    width: 760px;
}

.wordmark {
    font-size: 76px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.tagline {
    color: var(--vp-amber);
    font-size: 19px;
    letter-spacing: 5px;
    margin-top: 28px;
}

.button-row {
    flex-direction: row;
    align-items: center;
}

.landing__actions {
    margin-top: 54px;
}

.landing__actions > .button {
    margin-right: 16px;
}

.landing__mode {
    width: 220px;
}

.landing__settings {
    width: 150px;
}

.landing__exit {
    width: 96px;
}

.button--quiet {
    border-color: rgba(0, 0, 0, 0);
    color: var(--vp-dim);
}

.build-label {
    position: absolute;
    right: 64px;
    bottom: 48px;
    color: var(--vp-dim);
    font-size: 11px;
}

.back-button {
    position: absolute;
    left: 64px;
    top: 142px;
    width: 160px;
    height: 42px;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vp-dim);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
}

.back-button:hover {
    color: var(--vp-amber);
}

.screen-heading {
    position: absolute;
    left: 64px;
    top: 220px;
}

.callsign-row {
    position: absolute;
    left: 64px;
    top: 340px;
    width: 520px;
}

.callsign-field > .micro {
    margin-bottom: 8px;
}

.mode-tabs {
    position: absolute;
    left: 64px;
    right: 64px;
    top: 444px;
    height: 76px;
    flex-direction: row;
}

.mode-tab {
    flex-grow: 1;
    border-width: 1px;
    border-right-width: 0;
    border-color: var(--vp-border-strong);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vp-dim);
    font-size: 14px;
    -unity-font-style: bold;
}

.mode-tab--last {
    border-right-width: 1px;
}

.mode-tab:hover {
    color: var(--vp-ink);
    background-color: var(--vp-amber-soft);
}

.mode-tab--active {
    background-color: var(--vp-amber);
    color: rgb(25, 18, 7);
}

.mode-information {
    position: absolute;
    left: 64px;
    right: 64px;
    top: 590px;
    bottom: 68px;
    align-items: center;
    justify-content: center;
}

.mode-information__eyebrow {
    color: var(--vp-dim);
}

.mode-information__title {
    max-width: 980px;
    color: var(--vp-ink);
    font-size: 20px;
    -unity-text-align: middle-center;
    margin-bottom: 24px;
}

.join-panel {
    position: absolute;
    left: 64px;
    right: 64px;
    top: 360px;
    bottom: 68px;
    align-items: center;
    justify-content: center;
}

.join-panel__label {
    color: var(--vp-dim);
    font-size: 14px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    margin-bottom: 34px;
}

.code-field {
    width: 650px;
    height: 88px;
    font-size: 34px;
    letter-spacing: 18px;
    -unity-text-align: middle-center;
}

.code-field .unity-base-text-field__input {
    -unity-text-align: middle-center;
}

.join-panel__button {
    width: 340px;
    margin-top: 34px;
    margin-bottom: 42px;
}

.lobby-heading {
    flex-direction: row;
    justify-content: space-between;
}

.lobby-code-row {
    flex-direction: row;
    align-items: center;
}

.lobby-code {
    font-size: 32px;
    -unity-font-style: bold;
    letter-spacing: 8px;
    margin-right: 20px;
}

.lobby-copy {
    height: 46px;
    min-width: 110px;
}

.lobby-map {
    align-items: flex-end;
}

.lobby-map__name {
    font-size: 16px;
    -unity-font-style: bold;
    margin-top: 8px;
}

.player-count {
    margin-top: 42px;
    margin-bottom: 12px;
    color: var(--vp-dim);
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.player-grid {
    flex-grow: 1;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: space-between;
}

.player-slot {
    width: 49.2%;
    height: 130px;
    margin-bottom: 18px;
    border-width: 1px;
    border-color: var(--vp-border);
    background-color: rgba(18, 23, 29, 0.55);
    flex-direction: row;
    align-items: center;
    padding-left: 30px;
    padding-right: 30px;
    transition-property: border-color, background-color, opacity, translate;
    transition-duration: 0.18s;
}

.player-slot--host {
    border-color: var(--vp-amber);
    background-color: var(--vp-amber-soft);
}

.player-slot__badge {
    width: 72px;
    height: 72px;
    border-width: 1px;
    border-color: var(--vp-border-strong);
    color: var(--vp-amber);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-right: 24px;
}

.player-slot__details {
    flex-grow: 1;
}

.player-slot__name {
    font-size: 18px;
    -unity-font-style: bold;
}

.player-slot__meta {
    color: var(--vp-dim);
    font-size: 12px;
    margin-top: 8px;
}

.player-slot__state {
    height: 42px;
    min-width: 118px;
    border-width: 1px;
    border-color: var(--vp-border);
    color: var(--vp-dim);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.player-slot__state--ready {
    border-color: var(--vp-green);
    background-color: var(--vp-green-soft);
    color: var(--vp-green);
}

.player-slot--empty {
    justify-content: center;
    color: var(--vp-dim);
}

.lobby-actions {
    height: 76px;
    flex-direction: row;
}

.lobby-actions > .button {
    margin-right: 16px;
}

.lobby-actions__spacer {
    flex-grow: 1;
}

.start-match {
    width: 500px;
    margin-right: 0;
}

.settings-shell {
    position: absolute;
    width: 1280px;
    height: 760px;
    left: 50%;
    top: 50%;
    translate: -640px -380px;
}

.settings-heading {
    height: 180px;
    padding: 42px 56px 30px 56px;
}

.settings-tabs {
    height: 76px;
    flex-direction: row;
}

.settings-tab {
    flex-grow: 1;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-right-width: 1px;
    border-color: var(--vp-border);
    color: var(--vp-dim);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.settings-tab--active {
    background-color: var(--vp-amber);
    color: rgb(25, 18, 7);
}

.settings-body {
    flex-grow: 1;
    padding: 28px 56px 20px 56px;
}

.setting-row {
    height: 76px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-bottom-width: 1px;
    border-bottom-color: var(--vp-border);
}

.setting-row__label {
    font-size: 16px;
}

.stepper {
    flex-direction: row;
    align-items: center;
}

.stepper__button {
    width: 48px;
    height: 42px;
    border-width: 1px;
    border-color: var(--vp-border);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--vp-ink);
    font-size: 18px;
}

.stepper__button:hover {
    border-color: var(--vp-amber);
}

.stepper__value {
    width: 92px;
    -unity-text-align: middle-center;
}

.setting-row--button {
    width: 100%;
    border-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--vp-border);
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-text-align: middle-left;
    padding-left: 0;
}

.setting-row--button:hover {
    color: var(--vp-amber);
}

.settings-footer {
    height: 100px;
    border-top-width: 1px;
    border-top-color: var(--vp-border);
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    padding-right: 56px;
}

.loading-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    background-color: rgba(8, 12, 16, 0.98);
    align-items: center;
    justify-content: center;
}

.loading-content {
    width: 760px;
    align-items: center;
}

.loading-title {
    font-size: 38px;
    -unity-font-style: bold;
    letter-spacing: 2px;
}

.loading-message {
    margin-top: 16px;
}

.loading-track {
    width: 720px;
    height: 8px;
    margin-top: 56px;
    background-color: var(--vp-panel-soft);
}

.loading-progress {
    width: 0%;
    height: 8px;
    background-color: var(--vp-amber);
    transition-property: width;
    transition-duration: 0.18s;
}

.loading-spark {
    position: absolute;
    right: -3px;
    top: -4px;
    width: 7px;
    height: 14px;
    background-color: rgb(255, 224, 158);
}

.loading-percent {
    align-self: flex-end;
    margin-top: 10px;
}

.loading-tip {
    margin-top: 44px;
}

.status-footer {
    position: absolute;
    left: 50%;
    bottom: 28px;
    width: 620px;
    height: 30px;
    translate: -310px 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.status-dot {
    width: 6px;
    height: 6px;
    background-color: var(--vp-amber);
    margin-right: 12px;
}

.status-label {
    color: var(--vp-dim);
    font-size: 11px;
    letter-spacing: 1px;
    transition-property: color, opacity;
    transition-duration: 0.16s;
}

.compact .wordmark {
    font-size: 60px;
}

.compact .landing {
    left: 5%;
    top: 32%;
}

.compact .player-slot {
    height: 110px;
}

.compact .settings-shell {
    width: 1080px;
    translate: -540px -380px;
}
